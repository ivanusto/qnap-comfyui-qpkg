#!/bin/sh
# Install and removal hooks for the ComfyUI QPKG.
#
# The package itself is stateless. All data lives in <Container>/comfyui.
# Reinstalling or upgrading never touches an existing output, user,
# models-local or custom_nodes directory, and never overwrites a compose file
# or YAML you have edited.

COMFY_REF="v0.35.1"

# /share is a tmpfs. /share/Container and /share/Public are symlinks into
# <pool>_DATA/<folder>, and the pool name differs per machine: CACHEDEV1_DATA on
# many models, ZFS<n>_DATA on QuTS hero. Never hard code either form; resolve
# them at install time.
# Note that readlink on QTS is /usr/bin/readlink, not /bin/readlink. Getting
# that path wrong and then discarding stderr silently takes the fallback branch
# and everything looks fine.
resolve_share() {
    _p=$(/usr/bin/readlink -f "/share/$1")
    if [ -d "$_p" ]; then
        echo "$_p"
    else
        echo "/share/$1"
    fi
}

pkg_post_install() {
    STACK="$(resolve_share Container)/comfyui"
    PUBLIC="$(resolve_share Public)"
    MODELS_SHARED="$PUBLIC/models"

    /bin/mkdir -p \
        "$STACK/ComfyUI" "$STACK/custom_nodes" "$STACK/user" "$STACK/pip-extra" \
        "$STACK/models-local/diffusion_models" "$STACK/models-local/text_encoders" \
        "$STACK/models-local/vae" "$STACK/models-local/loras" \
        "$STACK/models-local/unet" "$STACK/models-local/clip" \
        "$STACK/output" "$STACK/input" "$STACK/temp" "$STACK/logs" "$STACK/.docker"

    # Create the shared model folder if it is missing, otherwise the read only
    # bind mount in compose fails.
    /bin/mkdir -p "$MODELS_SHARED"

    # Never overwrite an existing file, so local edits survive an upgrade.
    for f in Dockerfile docker-compose.yml entrypoint.sh extra_model_paths.yaml; do
        if [ ! -f "$STACK/$f" ]; then
            /bin/cp "$SYS_QPKG_DIR/$f" "$STACK/$f"
        fi
    done
    /bin/chmod +x "$STACK/entrypoint.sh"

    # Run as admin and the everyone group. That is the QNAP convention and it
    # guarantees write access to whichever shared folder the user picks.
    # Note that "everyone" is a GROUP, not a user, so id -g everyone always
    # fails. Read /etc/group directly.
    PUID=$(awk -F: '$1=="admin"{print $3}' /etc/passwd 2>/dev/null)
    [ -n "$PUID" ] || PUID=0
    PGID=$(awk -F: '$1=="everyone"{print $3}' /etc/group 2>/dev/null)
    [ -n "$PGID" ] || PGID=100

    # From ComfyUI v0.35 on, the container memory limit is read back as the
    # machine's total RAM and sizes the pinned memory pool. A fixed small value
    # starves a large NAS, so derive it from physical RAM. Leave 8 GB for QTS
    # and other containers, and on QuTS hero also the ZFS ARC floor: the ARC is
    # not counted in MemAvailable, cannot be capped from userland, and under
    # pressure only shrinks as far as arc_min. Without ZFS the floor is 0.
    ARC_MIN_KB=$(/sbin/sysctl -n vfs.zfs.arc_min 2>/dev/null | awk '{ print int($1 / 1024) }')
    [ -n "$ARC_MIN_KB" ] || ARC_MIN_KB=0
    MEM_LIMIT_GB=$(awk -v arc="$ARC_MIN_KB" '/^MemTotal:/ { g = int(($2 - arc) / 1048576) - 8; if (g < 8) g = 8; print g }' /proc/meminfo 2>/dev/null)
    [ -n "$MEM_LIMIT_GB" ] || MEM_LIMIT_GB=26

    # Everything that varies per machine lives in .env, so compose holds no
    # absolute paths. Never overwrite it: the user's tuning has to survive.
    if [ ! -f "$STACK/.env" ]; then
        {
            echo "# Generated by the ComfyUI QPKG at install time."
            echo "# Restart the package after editing."
            echo "COMFY_REF=$COMFY_REF"
            echo "COMFY_STACK=$STACK"
            echo "COMFY_MODELS_SHARED=$MODELS_SHARED"
            echo "COMFY_PORT=8188"
            echo ""
            echo "# Ownership of generated files. QNAP's admin is uid 0, so this"
            echo "# defaults to root. To run unprivileged, set a real uid here"
            echo "# and chown the stack directory to it."
            echo "PUID=$PUID"
            echo "PGID=$PGID"
            echo "TZ=$(/sbin/getcfg System 'Time Zone' -d UTC -f /etc/config/uLinux.conf 2>/dev/null || echo UTC)"
            echo ""
            echo "# GPU. Confirm the runtime name with: docker info | grep Runtimes"
            echo "COMFY_GPU_RUNTIME=nvidia-runtime"
            echo "NVIDIA_VISIBLE_DEVICES=all"
            echo ""
            echo "# GB of VRAM held back from ComfyUI. Raise this if you hit OOM."
            echo "COMFY_RESERVE_VRAM=0.5"
            echo ""
            echo "# Memory guard rails. ComfyUI v0.35 and later treat COMFY_MEM_LIMIT"
            echo "# as total RAM. Install sets physical RAM minus the ZFS ARC floor"
            echo "# minus 8 GB. Too low makes big models slow; too high makes the"
            echo "# host swap, because the ARC does not give memory back quickly."
            echo "COMFY_MEM_LIMIT=${MEM_LIMIT_GB}g"
            echo "COMFY_MEMSWAP_LIMIT=$((MEM_LIMIT_GB + 24))g"
            echo "COMFY_SHM_SIZE=2gb"
            echo ""
            echo "# The torch wheels must match your driver's CUDA version."
            echo "# There is a table in the README."
            echo "TORCH_INDEX=https://download.pytorch.org/whl/cu128"
            echo "TORCH_VERSION=2.9.1+cu128"
            echo "TORCHVISION_VERSION=0.24.1+cu128"
            echo "TORCHAUDIO_VERSION=2.9.1+cu128"
        } > "$STACK/.env"
    fi

    # Substitute the real path into the service script.
    /bin/sed -i "s#^STACK=__STACK_PATH__#STACK=$STACK#" "$SYS_QPKG_DIR/ComfyUI.sh"

    # ComfyUI's source is a bind mount, so upgrading it later is a matter of
    # swapping the checkout rather than rebuilding the image. QTS has no git,
    # so fetch a tarball. curl lives in /sbin here, not /usr/bin.
    if [ ! -f "$STACK/ComfyUI/main.py" ]; then
        $CMD_WLOG "ComfyUI: downloading source $COMFY_REF" 4
        /sbin/curl -fsSL -o /tmp/comfyui-src.tar.gz \
            "https://codeload.github.com/comfyanonymous/ComfyUI/tar.gz/refs/tags/$COMFY_REF" \
            >> "$STACK/logs/qpkg.log" 2>&1
        /bin/tar -xzf /tmp/comfyui-src.tar.gz --strip-components=1 -C "$STACK/ComfyUI" \
            >> "$STACK/logs/qpkg.log" 2>&1
        /bin/rm -f /tmp/comfyui-src.tar.gz
        # The bundled example nodes would be shadowed by the custom_nodes bind
        # mount, so copy them out first.
        for n in websocket_image_save.py example_node.py.example; do
            [ -f "$STACK/ComfyUI/custom_nodes/$n" ] && \
                /bin/cp "$STACK/ComfyUI/custom_nodes/$n" "$STACK/custom_nodes/$n"
        done
    fi

    /bin/chown -R "$PUID:$PGID" "$STACK"

    $CMD_WLOG "ComfyUI installed. Data directory $STACK, settings in $STACK/.env. The first start builds the image and takes 15 to 30 minutes." 4
}

pkg_pre_remove() {
    STACK="$(resolve_share Container)/comfyui"
    $CMD_WLOG "Removing ComfyUI. The data directory $STACK is kept and will not be deleted." 4
}
